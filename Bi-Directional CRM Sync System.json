        "jsCode": "const item = $input.first();\nconst data = item.json;\n\nconst airtable = $('Validate and Normalize Airtable Record').item.json;\n\n// Find Google Sheets Row থেকে কিছু data পাওয়া গেলে TRUE\nconst rowExists = Object.keys(data).length > 0;\n\nreturn [{\n  json: {\n    ...data,\n    ID: airtable.ID,\n    Name: airtable.Name,\n    Email: airtable.Email,\n    Phone: airtable.Phone,\n    Status: airtable.Status,\n    Amount: airtable.Amount,\n    rowExists,\n    action: rowExists ? \"UPDATE\" : \"CREATE\"\n  }\n}];"
