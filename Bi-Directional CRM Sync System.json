        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst previousRows = staticData.rows || {};\n\nconst items = $input.all();\nconst output = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const row = items[i].json;\n\n  const rowNumber = row.row_number || i + 2;\n  const key = String(rowNumber);\n\n  // Business data only — sync metadata বাদ\n  const currentData = {\n    recordId: row['Airtable record id'] || '',\n    name: row['Name'] || '',\n    email: row['Email'] || '',\n    phone: row['Phone'] || '',\n    status: row['Status'] || '',\n    amount: row['Amount'] || ''\n  };\n\n  const currentHash = JSON.stringify(currentData);\n  const previousHash = previousRows[key];\n\n  // New row অথবা actual business-data change\n  if (!previousHash || currentHash !== previousHash) {\n    output.push({\n      json: {\n        ...row,\n        _sheet_row_number: rowNumber,\n        _detected_at: new Date().toISOString()\n      },\n      pairedItem: { item: i }\n    });\n  }\n\n  // Current state save\n  previousRows[key] = currentHash;\n}\n\nstaticData.rows = previousRows;\n\nreturn output;"
